---
import { CLOUDFLARE_ANALYTICS_TOKEN } from "../data/site";
/**
 * Cloudflare Web Analytics: counts page views with no cookies and no personal data,
 * so no consent banner is needed. Renders nothing until the token is set.
 */
const beacon = JSON.stringify({ token: CLOUDFLARE_ANALYTICS_TOKEN });
---

{
  CLOUDFLARE_ANALYTICS_TOKEN && (
    <script is:inline type="module" src="https://static.cloudflareinsights.com/beacon.min.js" data-cf-beacon={beacon} />
  )
}
