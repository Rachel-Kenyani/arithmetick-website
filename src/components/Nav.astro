---
import PlayButton from "./PlayButton.astro";

interface Props {
  current?: "home" | "how" | "privacy" | "contact";
  /** Start see-through with a white logo, over a dark hero, and turn to frosted glass on scroll. */
  overHero?: boolean;
}
const { current, overHero = false } = Astro.props;
const links = [
  { id: "home", label: "For families", href: "/" },
  { id: "how", label: "How it works", href: "/how-it-works" },
  { id: "contact", label: "Contact us", href: "/contact" },
] as const;
---

<header class:list={["nav", overHero && "over-hero"]}>
  <div class="container bar">
    <a class="logo" href="/" aria-label="ArithmeTick home">
      <img class="logo-dark" src="/images/logo-horizontal.svg" width="154" height="32" alt="" />
      {overHero && <img class="logo-light" src="/images/logo-horizontal-white.svg" width="154" height="32" alt="" />}
    </a>
    <nav aria-label="Main">
      <ul class="links">
        {
          links.map((l) => (
            <li>
              <a href={l.href} aria-current={current === l.id ? "page" : undefined}>
                {l.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
    <PlayButton size="sm" class="cta" />
    <details class="menu">
      <summary aria-label="Menu">
        <span></span><span></span><span></span>
      </summary>
      <ul>
        {
          links.map((l) => (
            <li>
              <a href={l.href} aria-current={current === l.id ? "page" : undefined}>
                {l.label}
              </a>
            </li>
          ))
        }
      </ul>
    </details>
  </div>
  <div class="progress" aria-hidden="true"></div>
  <img class="rider" src="/images/figma/owl-head.svg" width="26" height="24" alt="" aria-hidden="true" />
</header>

<script>
  /* Frost the bar and tighten it once the page scrolls. */
  const header = document.querySelector<HTMLElement>(".nav");
  if (header) {
    const onScroll = () => header.classList.toggle("scrolled", window.scrollY > 8);
    onScroll();
    window.addEventListener("scroll", onScroll, { passive: true });
  }

  /* Close the mobile menu on a tap outside it, on Escape, or after choosing a link. */
  const menu = document.querySelector<HTMLDetailsElement>(".nav .menu");
  if (menu) {
    const close = () => menu.removeAttribute("open");
    document.addEventListener("click", (event) => {
      if (menu.open && !menu.contains(event.target as Node)) {
        close();
      }
    });
    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape" && menu.open) {
        close();
        menu.querySelector("summary")?.focus();
      }
    });
    for (const link of menu.querySelectorAll("a")) {
      link.addEventListener("click", close);
    }
  }
</script>

<style>
  /* Frosted glass: the page shows through, blurred, under a light tint. */
  .nav {
    --nav-h: 72px;
    position: sticky;
    top: 0;
    z-index: 30;
    padding-top: env(safe-area-inset-top, 0px);
    background: rgb(255 255 255 / 0.72);
    -webkit-backdrop-filter: saturate(180%) blur(16px);
    backdrop-filter: saturate(180%) blur(16px);
    border-bottom: 1px solid transparent;
    transition:
      background-color 0.2s ease,
      border-color 0.2s ease;
  }
  .nav.scrolled {
    border-bottom-color: rgb(0 79 74 / 0.1);
  }
  @supports not ((backdrop-filter: blur(1px)) or (-webkit-backdrop-filter: blur(1px))) {
    .nav {
      background: var(--white);
    }
  }
  .bar {
    display: flex;
    align-items: center;
    gap: 16px;
    min-height: var(--nav-h);
    transition: min-height 0.2s ease;
  }
  .scrolled .bar {
    min-height: 60px;
  }

  /* Over the home hero: see-through until the page scrolls. The hero slides up underneath. */
  .nav.over-hero {
    margin-bottom: calc(-1 * (var(--nav-h) + env(safe-area-inset-top, 0px)));
  }
  .nav.over-hero:not(.scrolled) {
    background: transparent;
    -webkit-backdrop-filter: none;
    backdrop-filter: none;
  }
  .logo-light {
    display: none !important;
  }
  .over-hero:not(.scrolled) .logo-dark {
    display: none !important;
  }
  .over-hero:not(.scrolled) .logo-light {
    display: block !important;
  }
  .over-hero:not(.scrolled) .links a {
    color: var(--white);
  }
  .over-hero:not(.scrolled) .links a:hover,
  .over-hero:not(.scrolled) .links a[aria-current="page"] {
    color: var(--white);
    border-bottom-color: var(--white);
  }
  .over-hero:not(.scrolled) .menu summary span {
    background: var(--white);
  }
  .over-hero :focus-visible {
    outline-color: currentColor;
  }
  @media (prefers-reduced-motion: reduce) {
    .nav,
    .bar {
      transition: none;
    }
  }

  /* Reading progress along the bottom edge, driven by the page scroll with no script.
     Browsers without scroll-driven animations simply don't show it. */
  .progress {
    display: none;
  }
  @supports (animation-timeline: scroll()) {
    .progress {
      display: block;
      position: absolute;
      left: 0;
      right: 0;
      bottom: -1px;
      height: 3px;
      background: var(--teal-600);
      transform-origin: 0 50%;
      scale: 0 1;
      animation: read-progress linear both;
    }
    /* Kept in its own rule: the CSS minifier would fold it into the shorthand above, which browsers ignore. */
    .nav .progress {
      animation-timeline: scroll(root);
    }
    .over-hero:not(.scrolled) .progress {
      opacity: 0;
    }
  }
  /* Brijo rides the front of the progress line. */
  .rider {
    display: none;
  }
  @media (prefers-reduced-motion: no-preference) {
    @supports (animation-timeline: scroll()) {
      .rider {
        display: block;
        position: absolute;
        left: 0;
        bottom: -12px;
        width: 26px;
        height: 24px;
        margin-left: -13px;
        pointer-events: none;
        filter: drop-shadow(0 2px 2px rgb(0 0 0 / 0.15));
        animation-name: ride;
        animation-timing-function: linear;
        animation-fill-mode: both;
        animation-timeline: scroll(root);
      }
      .over-hero:not(.scrolled) .rider {
        opacity: 0;
      }
    }
  }
  @keyframes ride {
    from {
      translate: 0 0;
      rotate: -8deg;
    }
    50% {
      rotate: 8deg;
    }
    to {
      translate: calc(100vw - 16px) 0;
      rotate: -8deg;
    }
  }
  @keyframes read-progress {
    to {
      scale: 1 1;
    }
  }
  nav {
    margin-left: auto;
  }
  .logo {
    display: flex;
    flex-shrink: 0;
  }
  .logo img {
    display: block;
    width: 154px;
    height: 32px;
  }
  .links {
    display: flex;
    align-items: center;
    gap: 32px;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .links a,
  .menu a:not(.btn) {
    display: inline-block;
    padding: 6px 0 4px;
    border-bottom: 2px solid transparent;
    color: var(--text);
    font-size: 16px;
    font-weight: 600;
    text-decoration: none;
    white-space: nowrap;
    transition:
      color 0.15s ease,
      border-color 0.15s ease;
  }
  .links a:hover,
  .links a[aria-current="page"],
  .menu a[aria-current="page"] {
    color: var(--purple-500);
    border-bottom-color: var(--purple-500);
  }
  .bar :global(.cta) {
    margin-left: 24px;
    flex: none;
  }
  .menu {
    display: none;
    position: relative;
  }
  .menu summary {
    list-style: none;
    display: grid;
    gap: 5px;
    width: 44px;
    height: 44px;
    place-content: center;
    cursor: pointer;
    border-radius: 10px;
  }
  .menu summary::-webkit-details-marker {
    display: none;
  }
  .menu summary span {
    display: block;
    width: 24px;
    height: 3px;
    border-radius: 3px;
    background: var(--ink);
  }
  .menu ul {
    position: absolute;
    right: 0;
    top: 52px;
    display: grid;
    gap: 14px;
    min-width: 220px;
    margin: 0;
    padding: 18px;
    list-style: none;
    background: rgb(255 255 255 / 0.92);
    -webkit-backdrop-filter: saturate(180%) blur(16px);
    backdrop-filter: saturate(180%) blur(16px);
    border: 1px solid rgb(0 79 74 / 0.1);
    border-radius: var(--radius-md);
    box-shadow: 0 12px 30px rgba(0, 79, 74, 0.18);
  }
  @media (max-width: 480px) {
    .bar {
      gap: 10px;
    }
    .logo img {
      width: 128px;
      height: auto;
    }
  }
  @media (max-width: 359px) {
    .logo img {
      width: 108px;
    }
  }
  @media (max-width: 900px) {
    .bar :global(.cta) {
      margin-left: auto;
    }
  }
  /* On phones the Play badge moves to the sticky bar at the bottom (StickyPlay), where thumbs reach it. */
  @media (max-width: 700px) {
    .bar :global(.cta) {
      display: none;
    }
    .menu {
      margin-left: auto;
    }
    nav {
      display: none;
    }
    .menu {
      display: block;
    }
  }
</style>
