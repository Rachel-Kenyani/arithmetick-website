---
import PlayButton from "./PlayButton.astro";

interface Props {
  current?: "home" | "how" | "privacy" | "contact";
}
const { current } = Astro.props;
const links = [
  { id: "home", label: "For families", href: "/" },
  { id: "how", label: "How it works", href: "/how-it-works" },
  { id: "contact", label: "Contact us", href: "/contact" },
] as const;
---

<header class="nav">
  <div class="container bar">
    <a class="logo" href="/" aria-label="ArithmeTick home">
      <img src="/images/logo-horizontal.svg" width="154" height="32" alt="" />
    </a>
    <nav aria-label="Main">
      <ul class="links">
        {
          links.map((l) => (
            <li>
              <a href={l.href} aria-current={current === l.id ? "page" : undefined}>
                {l.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
    <PlayButton size="sm" class="cta" />
    <details class="menu">
      <summary aria-label="Menu">
        <span></span><span></span><span></span>
      </summary>
      <ul>
        {
          links.map((l) => (
            <li>
              <a href={l.href} aria-current={current === l.id ? "page" : undefined}>
                {l.label}
              </a>
            </li>
          ))
        }
      </ul>
    </details>
  </div>
</header>

<script>
  /* Close the mobile menu on a tap outside it, on Escape, or after choosing a link. */
  const menu = document.querySelector<HTMLDetailsElement>(".nav .menu");
  if (menu) {
    const close = () => menu.removeAttribute("open");
    document.addEventListener("click", (event) => {
      if (menu.open && !menu.contains(event.target as Node)) {
        close();
      }
    });
    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape" && menu.open) {
        close();
        menu.querySelector("summary")?.focus();
      }
    });
    for (const link of menu.querySelectorAll("a")) {
      link.addEventListener("click", close);
    }
  }
</script>

<style>
  .nav {
    position: sticky;
    top: 0;
    z-index: 30;
    background: var(--white);
    box-shadow: 0 1px 1px rgba(0, 0, 0, 0.05);
    padding-top: env(safe-area-inset-top, 0px);
  }
  .bar {
    display: flex;
    align-items: center;
    gap: 16px;
    padding-top: 12px;
    padding-bottom: 12px;
  }
  nav {
    margin-left: auto;
  }
  .logo {
    display: flex;
    flex-shrink: 0;
  }
  .logo img {
    display: block;
    width: 154px;
    height: 32px;
  }
  .links {
    display: flex;
    align-items: center;
    gap: 32px;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .links a,
  .menu a:not(.btn) {
    display: inline-block;
    padding: 6px 0 4px;
    border-bottom: 2px solid transparent;
    color: var(--text);
    font-size: 16px;
    font-weight: 600;
    text-decoration: none;
    white-space: nowrap;
  }
  .links a:hover,
  .links a[aria-current="page"],
  .menu a[aria-current="page"] {
    color: var(--purple-500);
    border-bottom-color: var(--purple-500);
  }
  .bar :global(.cta) {
    margin-left: 24px;
    flex: none;
  }
  .menu {
    display: none;
    position: relative;
  }
  .menu summary {
    list-style: none;
    display: grid;
    gap: 5px;
    width: 44px;
    height: 44px;
    place-content: center;
    cursor: pointer;
    border-radius: 10px;
  }
  .menu summary::-webkit-details-marker {
    display: none;
  }
  .menu summary span {
    display: block;
    width: 24px;
    height: 3px;
    border-radius: 3px;
    background: var(--ink);
  }
  .menu ul {
    position: absolute;
    right: 0;
    top: 52px;
    display: grid;
    gap: 14px;
    min-width: 220px;
    margin: 0;
    padding: 18px;
    list-style: none;
    background: var(--white);
    border-radius: var(--radius-md);
    box-shadow: 0 12px 30px rgba(0, 79, 74, 0.18);
  }
  @media (max-width: 480px) {
    .bar {
      gap: 10px;
    }
    .logo img {
      width: 128px;
      height: auto;
    }
  }
  @media (max-width: 359px) {
    .logo img {
      width: 108px;
    }
  }
  @media (max-width: 900px) {
    .bar :global(.cta) {
      margin-left: auto;
    }
  }
  /* On phones the Play badge moves to the sticky bar at the bottom (StickyPlay), where thumbs reach it. */
  @media (max-width: 700px) {
    .bar :global(.cta) {
      display: none;
    }
    .menu {
      margin-left: auto;
    }
    nav {
      display: none;
    }
    .menu {
      display: block;
    }
  }
</style>
