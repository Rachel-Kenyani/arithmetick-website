---
interface Props {
  current?: "home" | "how" | "privacy" | "contact";
}
const { current } = Astro.props;
const links = [
  { id: "home", label: "For Families", href: "/" },
  { id: "how", label: "How It Works", href: "/how-it-works" },
  { id: "privacy", label: "Privacy", href: "/privacy" },
  { id: "contact", label: "Contact", href: "/contact" },
] as const;
---

<header class="nav">
  <div class="container bar">
    <a class="logo" href="/" aria-label="ArithmeTick home">
      <img src="/images/figma/logo.svg" width="123.57" height="32" alt="" />
    </a>
    <nav aria-label="Main">
      <ul class="links">
        {
          links.map((l) => (
            <li>
              <a href={l.href} aria-current={current === l.id ? "page" : undefined}>
                {l.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
    <a class="btn btn-primary cta" href="/contact#beta">Join the Beta</a>
    <details class="menu">
      <summary aria-label="Menu">
        <span></span><span></span><span></span>
      </summary>
      <ul>
        {
          links.map((l) => (
            <li>
              <a href={l.href} aria-current={current === l.id ? "page" : undefined}>
                {l.label}
              </a>
            </li>
          ))
        }
        <li><a class="btn btn-primary" href="/contact#beta">Join the Beta</a></li>
      </ul>
    </details>
  </div>
</header>

<style>
  .nav {
    position: sticky;
    top: 0;
    z-index: 30;
    background: var(--nav-bg);
    box-shadow: 0 1px 1px rgba(0, 0, 0, 0.05);
    padding-top: env(safe-area-inset-top, 0px);
  }
  .bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    padding-top: 16px;
    padding-bottom: 16px;
  }
  .logo {
    display: flex;
    flex-shrink: 0;
  }
  .logo img {
    display: block;
    width: 123.57px;
    height: 32px;
  }
  .links {
    display: flex;
    gap: 24px;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .links a,
  .menu a:not(.btn) {
    display: inline-block;
    padding-bottom: 4px;
    border-bottom: 2px solid transparent;
    color: var(--ink);
    font-size: 18px;
    font-weight: 500;
    text-decoration: none;
    white-space: nowrap;
  }
  .links a:hover,
  .links a[aria-current="page"],
  .menu a[aria-current="page"] {
    color: var(--purple-nav);
    border-bottom-color: var(--purple-nav);
  }
  .cta {
    padding: 12px 24px;
  }
  .menu {
    display: none;
    position: relative;
  }
  .menu summary {
    list-style: none;
    display: grid;
    gap: 5px;
    width: 44px;
    height: 44px;
    place-content: center;
    cursor: pointer;
    border-radius: 10px;
  }
  .menu summary::-webkit-details-marker {
    display: none;
  }
  .menu summary span {
    display: block;
    width: 24px;
    height: 3px;
    border-radius: 3px;
    background: var(--teal-deep);
  }
  .menu ul {
    position: absolute;
    right: 0;
    top: 52px;
    display: grid;
    gap: 14px;
    min-width: 220px;
    margin: 0;
    padding: 18px;
    list-style: none;
    background: var(--white);
    border-radius: var(--radius-md);
    box-shadow: 0 12px 30px rgba(0, 79, 74, 0.18);
  }
  @media (max-width: 900px) {
    nav,
    .cta {
      display: none;
    }
    .menu {
      display: block;
    }
  }
</style>
