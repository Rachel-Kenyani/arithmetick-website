---
/**
 * Brijo the owl, assembled from the Figma parts at their exact positions (the design's 128 × 180 frame). `size` sets
 * the rendered height; everything scales with it.
 */
interface Props {
  size?: number;
  class?: string;
}
const { size = 180, class: className } = Astro.props;
const scale = size / 180;
const P = "/images/figma/";
type Part = { box: [number, number, number, number]; img: string; w: number; h: number; rot: string };
const parts: Part[] = [
  { box: [3.57, 96.81, 61.209, 73.576], img: "owl-wing-left.svg", w: 31.512, h: 66.854, rot: "rotate(-30.67deg)" },
  { box: [66.17, 96.97, 61.117, 73.42], img: "owl-wing-right.svg", w: 31.512, h: 66.673, rot: "rotate(-149.33deg) scaleY(-1)" },
  { box: [0, 59.68, 118.895, 120.027], img: "owl-body.svg", w: 88.248, h: 82.193, rot: "rotate(-52.6deg)" },
  ...[
    [34.66, 105.64],
    [53.93, 105.94],
    [73.19, 106.24],
    [63.84, 119.35],
    [54.51, 132.76],
    [44.6, 119.35],
  ].map(([x, y]): Part => ({ box: [x, y, 19.777, 19.833], img: "owl-spot.svg", w: 14.279, h: 13.978, rot: "rotate(-52.6deg)" })),
  { box: [2.46, 0, 125.669, 121.922], img: "owl-head.svg", w: 99.72, h: 93.452, rot: "rotate(20deg)" },
];
const feet = [37.6, 45.76, 53.93, 67.92, 76.08, 84.25];
---

<div class={`owl ${className ?? ""}`} style={`--s:${scale}`} role="img" aria-label="Brijo the owl">
  <div class="frame">
    {feet.map((x) => <span class="foot" style={`left:${x}px`} />)}
    {
      parts.map((p) => (
        <span class="part" style={`left:${p.box[0]}px;top:${p.box[1]}px;width:${p.box[2]}px;height:${p.box[3]}px`}>
          <img src={P + p.img} width={p.w} height={p.h} alt="" style={`transform:${p.rot}`} />
        </span>
      ))
    }
  </div>
</div>

<style>
  .owl {
    position: relative;
    width: calc(128.131px * var(--s));
    height: calc(180px * var(--s));
  }
  .frame {
    position: absolute;
    left: 0;
    top: 0;
    width: 128.131px;
    height: 180px;
    transform: scale(var(--s));
    transform-origin: 0 0;
  }
  .part {
    position: absolute;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .part img {
    display: block;
    max-width: none;
    flex: none;
  }
  .foot {
    position: absolute;
    top: 161.92px;
    width: 8.164px;
    height: 18.078px;
    border-radius: 18px;
    background: #fead1d;
    border: 2px solid #000;
    box-sizing: border-box;
  }
</style>
