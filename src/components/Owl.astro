---
/**
 * Brijo the owl, assembled from the Figma parts at their exact positions (the design's 128 × 180 frame). `size` sets
 * the rendered height; everything scales with it.
 */
interface Props {
  size?: number;
  class?: string;
}
const { size = 180, class: className } = Astro.props;
const scale = size / 180;
const P = "/images/figma/";
type Part = { box: [number, number, number, number]; img: string; w: number; h: number; rot: string; head?: boolean };
const parts: Part[] = [
  { box: [3.57, 96.81, 61.209, 73.576], img: "owl-wing-left.svg", w: 31.512, h: 66.854, rot: "rotate(-30.67deg)" },
  { box: [66.17, 96.97, 61.117, 73.42], img: "owl-wing-right.svg", w: 31.512, h: 66.673, rot: "rotate(-149.33deg) scaleY(-1)" },
  { box: [0, 59.68, 118.895, 120.027], img: "owl-body.svg", w: 88.248, h: 82.193, rot: "rotate(-52.6deg)" },
  ...[
    [34.66, 105.64],
    [53.93, 105.94],
    [73.19, 106.24],
    [63.84, 119.35],
    [54.51, 132.76],
    [44.6, 119.35],
  ].map(([x, y]): Part => ({ box: [x, y, 19.777, 19.833], img: "owl-spot.svg", w: 14.279, h: 13.978, rot: "rotate(-52.6deg)" })),
  { box: [2.46, 0, 125.669, 121.922], img: "owl-head.svg", w: 99.72, h: 93.452, rot: "rotate(20deg)", head: true },
];
const feet = [37.6, 45.76, 53.93, 67.92, 76.08, 84.25];
---

<div class={`owl ${className ?? ""}`} style={`--s:${scale}`} role="img" aria-label="Brijo the owl">
  <div class="frame">
    {feet.map((x) => <span class="foot" style={`left:${x}px`} />)}
    {
      parts.map((p) => (
        <span class:list={["part", p.head && "head"]} style={`left:${p.box[0]}px;top:${p.box[1]}px;width:${p.box[2]}px;height:${p.box[3]}px`}>
          <img src={P + p.img} width={p.w} height={p.h} alt="" style={`transform:${p.rot}`} />
        </span>
      ))
    }
  </div>
</div>

<script>
  /* Brijo reacts: when the mouse comes near, she stops looking around and turns to watch it.
     A tap or click makes her hop. Off for people who reduce motion. */
  const owls = [...document.querySelectorAll<HTMLElement>(".owl")];
  const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
  if (owls.length && !reduceMotion) {
    const RANGE = 420;
    let idleTimer: number | undefined;
    window.addEventListener(
      "pointermove",
      (event) => {
        for (const owl of owls) {
          const head = owl.querySelector<HTMLElement>(".head");
          if (!head) {
            continue;
          }
          const box = owl.getBoundingClientRect();
          const dx = event.clientX - (box.left + box.width / 2);
          const dy = event.clientY - (box.top + box.height / 3);
          if (Math.hypot(dx, dy) < RANGE) {
            const look = Math.max(-16, Math.min(16, dx / 12));
            head.style.setProperty("--look", `${look}deg`);
            owl.classList.add("watching");
            window.clearTimeout(idleTimer);
            idleTimer = window.setTimeout(() => owl.classList.remove("watching"), 1500);
          } else {
            owl.classList.remove("watching");
          }
        }
      },
      { passive: true },
    );
    for (const owl of owls) {
      owl.addEventListener("click", () => {
        owl.classList.remove("hop");
        void owl.offsetWidth;
        owl.classList.add("hop");
      });
      owl.addEventListener("animationend", (event) => {
        if (event.animationName.startsWith("hop")) {
          owl.classList.remove("hop");
        }
      });
    }
  }
</script>

<style>
  .owl {
    position: relative;
    width: calc(128.131px * var(--s));
    height: calc(180px * var(--s));
  }
  .frame {
    position: absolute;
    left: 0;
    top: 0;
    width: 128.131px;
    height: 180px;
    transform: scale(var(--s));
    transform-origin: 0 0;
  }
  .part {
    position: absolute;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .part img {
    display: block;
    max-width: none;
    flex: none;
  }
  /* Brijo looks around: a turn to one side, back to the front, then the other side. Pivots at the neck. */
  .head {
    transform-origin: 50% 80%;
    animation: look-around 6s ease-in-out infinite;
  }
  @keyframes look-around {
    0%,
    18%,
    50%,
    68%,
    100% {
      transform: rotate(0deg);
    }
    28%,
    40% {
      transform: rotate(-14deg);
    }
    78%,
    90% {
      transform: rotate(12deg);
    }
  }
  .watching .head {
    animation: none;
    transform: rotate(var(--look, 0deg));
    transition: transform 0.25s ease-out;
  }
  .owl.hop {
    animation: hop 0.5s ease-out;
  }
  @keyframes hop {
    30% {
      translate: 0 -16px;
    }
    55% {
      translate: 0 0;
    }
    70% {
      translate: 0 -5px;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .head {
      animation: none;
    }
  }
  .foot {
    position: absolute;
    top: 161.92px;
    width: 8.164px;
    height: 18.078px;
    border-radius: 18px;
    background: #fead1d;
    border: 2px solid #000;
    box-sizing: border-box;
  }
</style>
