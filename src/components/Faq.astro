---
/** An FAQ accordion with a centred heading. Pass `items` for one list, or `groups` for titled lists. */
type Item = { question: string; answer: string };
interface Props {
  items?: Item[];
  /** Titled groups of questions, shown one after another. */
  groups?: { title: string; items: Item[] }[];
  title?: string;
  /** The first question opens by default. */
  openFirst?: boolean;
  /** The line under the heading. Defaults to a link to the Contact page. */
  lede?: string;
  /** A "See all questions" link under the list, for a short version of the FAQ. */
  moreHref?: string;
}
const { items = [], groups, title = "Questions parents ask", openFirst = true, lede, moreHref } = Astro.props;
const lists = groups ?? [{ title: "", items }];
---

<section class="faq" id="faq">
  <div class="container faq-grid">
    <div class="section-head faq-head">
      <h2 class="heading-lg">{title}</h2>
      {lede ? <p class="lede">{lede}</p> : <p class="lede">Anything else? <a href="/contact">Get in touch</a>.</p>}
    </div>
    {
      lists.map((list, li) => (
        <div class="faq-group">
          {list.title && <h3 class="overline faq-group-title">{list.title}</h3>}
          <div class="faq-list">
            {list.items.map((f, i) => (
              <details open={openFirst && li === 0 && i === 0}>
                <summary>{f.question}</summary>
                <p>{f.answer}</p>
              </details>
            ))}
          </div>
        </div>
      ))
    }
    {moreHref && <a class="btn btn-outline more" href={moreHref}>See all questions</a>}
  </div>
</section>

<script>
  /* One answer open at a time, so the list stays short and scannable. */
  for (const list of document.querySelectorAll<HTMLElement>(".faq-list")) {
    const items = [...list.querySelectorAll<HTMLDetailsElement>("details")];
    for (const item of items) {
      item.addEventListener("toggle", () => {
        if (item.open) {
          for (const other of items) {
            if (other !== item) {
              other.open = false;
            }
          }
        }
      });
    }
  }
</script>

<style>
  .faq-group {
    display: grid;
    gap: var(--space-4);
  }
  .faq-group-title {
    color: var(--teal-700);
  }
  .more {
    justify-self: center;
  }
  .faq {
    scroll-margin-top: 72px;
    padding: var(--section-y) 0;
  }
  .faq-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-10);
  }
  .faq-list {
    display: grid;
    gap: var(--space-3);
  }
  .faq-list details {
    border: 1px solid var(--line);
    border-radius: var(--radius-md);
    background: var(--white);
  }
  .faq-list summary {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: var(--space-4);
    min-height: 56px;
    padding: var(--space-3) var(--space-5);
    color: var(--ink);
    font-weight: 700;
    cursor: pointer;
    list-style: none;
  }
  .faq-list summary::-webkit-details-marker {
    display: none;
  }
  .faq-list summary::after {
    content: "";
    flex: none;
    width: 10px;
    height: 10px;
    border-right: 2px solid currentColor;
    border-bottom: 2px solid currentColor;
    rotate: 45deg;
    translate: 0 -3px;
    transition: rotate 0.15s ease;
  }
  .faq-list details[open] summary::after {
    rotate: 225deg;
    translate: 0 3px;
  }
  .faq-list details p {
    margin: 0 var(--space-5);
    padding: var(--space-4) 0 var(--space-5);
    border-top: 1px solid var(--line);
    color: var(--muted);
  }
  @media (max-width: 900px) {
    .faq-grid {
      gap: var(--space-6);
    }
  }
</style>
