---
/** A feature card: icon, title, short text, and an optional one-line takeaway at the bottom. */
interface Props {
  icon: string;
  title: string;
  /** Tint of the card and its icon tile. */
  tone?: "teal" | "purple" | "sun";
  /** A short takeaway shown under a divider, e.g. "You choose the daily limit". */
  note?: string;
}
const { icon, title, tone = "teal", note } = Astro.props;
---

<article class={`card ${tone}`}>
  <div class="top">
    <div class="icon"><img src={icon} width="28" height="28" alt="" /></div>
    <h3 class="heading-sm">{title}</h3>
    <p><slot /></p>
  </div>
  {note && <p class="note">{note}</p>}
</article>

<style>
  .card {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: var(--space-6);
    min-width: 0;
    padding: var(--space-8);
    border-radius: var(--radius-xl);
    border: 1px solid var(--line);
    background: var(--mint-50);
  }
  .card.purple {
    background: var(--purple-50);
    border-color: var(--purple-100);
  }
  .card.sun {
    background: var(--cream);
    border-color: var(--sun-100);
  }
  .top {
    display: grid;
    gap: var(--space-4);
  }
  .icon {
    display: grid;
    place-items: center;
    width: 52px;
    height: 52px;
    border-radius: var(--radius-md);
    background: var(--mint-100);
  }
  .purple .icon {
    background: var(--purple-100);
  }
  .sun .icon {
    background: var(--sun-50);
  }
  p {
    color: var(--muted);
    font-size: 17px;
  }
  .note {
    padding-top: var(--space-4);
    border-top: 1px solid var(--line);
    color: var(--ink);
    font-size: 14px;
    font-weight: 700;
  }
  .purple .note {
    border-color: var(--purple-100);
    color: var(--purple-700);
  }
  .sun .note {
    border-color: var(--sun-100);
  }
  @media (max-width: 600px) {
    .card {
      padding: var(--space-6);
    }
  }
</style>
