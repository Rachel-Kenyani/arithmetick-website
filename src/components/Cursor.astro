---
/**
 * A branded cursor for mouse users: a teal arrow, and a soft ring that trails it and grows over
 * anything clickable. Links keep the normal pointer hand. Off for touch screens and for people
 * who reduce motion.
 */
---

<div class="cursor-ring" aria-hidden="true"></div>

<script>
  const ring = document.querySelector<HTMLElement>(".cursor-ring");
  const finePointer = window.matchMedia("(hover: hover) and (pointer: fine)").matches;
  const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
  if (ring && finePointer && !reduceMotion) {
    document.documentElement.classList.add("has-cursor-ring");
    let x = -100;
    let y = -100;
    let ringX = x;
    let ringY = y;
    const follow = () => {
      ringX += (x - ringX) * 0.2;
      ringY += (y - ringY) * 0.2;
      ring.style.translate = `${ringX}px ${ringY}px`;
      requestAnimationFrame(follow);
    };
    window.addEventListener(
      "pointermove",
      (event) => {
        x = event.clientX;
        y = event.clientY;
        const target = event.target as Element;
        ring.classList.toggle("over-link", !!target.closest?.("a, button, summary, label, [role='button']"));
        ring.classList.add("shown");
      },
      { passive: true },
    );
    document.addEventListener("pointerleave", () => ring.classList.remove("shown"));
    window.addEventListener("pointerdown", () => ring.classList.add("pressed"));
    window.addEventListener("pointerup", () => ring.classList.remove("pressed"));
    requestAnimationFrame(follow);
  }
</script>

<style>
  @media (hover: hover) and (pointer: fine) {
    :global(html) {
      cursor:
        url("/images/cursor.svg") 4 2,
        auto;
    }
  }
  .cursor-ring {
    display: none;
  }
  :global(.has-cursor-ring) .cursor-ring {
    display: block;
    position: fixed;
    z-index: 100;
    top: -18px;
    left: -18px;
    width: 36px;
    height: 36px;
    border-radius: 50%;
    border: 1.5px solid var(--teal-600);
    pointer-events: none;
    opacity: 0;
    transition:
      opacity 0.2s ease,
      scale 0.2s ease,
      background-color 0.2s ease,
      border-color 0.2s ease;
  }
  :global(.has-cursor-ring) .cursor-ring.shown {
    opacity: 0.6;
  }
  .cursor-ring.over-link {
    scale: 1.6;
    border-color: var(--purple-500);
    background: rgb(126 79 203 / 0.12);
  }
  .cursor-ring.pressed {
    scale: 0.8;
  }
</style>
