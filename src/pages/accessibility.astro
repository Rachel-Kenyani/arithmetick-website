---
import Doc from "../layouts/Doc.astro";
import { SUPPORT_EMAIL as EMAIL } from "../data/site";
const toc = [
  { id: "aim", label: "What we aim for" },
  { id: "works", label: "What works today" },
  { id: "grown-ups", label: "Settings for grown-ups" },
