---
import Base from "../layouts/Base.astro";
import CtaBand from "../components/CtaBand.astro";
import PlayButton from "../components/PlayButton.astro";
import levels from "../data/levels.json";
import SkillArt from "../components/SkillArt.astro";

const F = "/images/figma/";
const SKILL_NAMES: Record<string, string> = {
  makingTen: "Making 10",
  takingAway: "Taking away",
  placeValue: "Place value",
  addingOn: "Adding on",
  countingInSteps: "Counting in steps",
  groups: "Equal groups",
  sharing: "Sharing equally",
  time: "Telling the time",
};
const GRADE_NAMES: Record<string, string> = { "1": "Counting Fun", "2": "Tens and Ones", "3": "Array Grids" };
const schema = [
  {
    "@context": "https://schema.org",
    "@type": "ItemList",
    name: "ArithmeTick levels, Grades 1 to 3",
    itemListElement: levels.flatMap((g) =>
      g.levels.map((l) => ({
        "@type": "ListItem",
        position: Number(g.grade) * 100 + l.n,
        item: {
          "@type": "LearningResource",
          name: `Grade ${g.grade}, Level ${l.n}: ${l.title}`,
          description: l.eq,
          educationalLevel: `Grade ${g.grade}`,
          learningResourceType: l.quest ? "Activity away from the screen" : "Game",
        },
      })),
    ),
  },
];
const steps = [
  {
    image: "/images/app/map.webp",
    alt: "The Grade 1 jungle map, with level 2 ready to play",
    title: "Choose the next stop on the map",
    text: "Levels unlock one at a time. After a hard level, the map suggests a quick warm-up first.",
  },
  {
    image: "/images/app/level.webp",
    alt: "Brijo asks: the wind blew away seven feathers, help Brijo collect them",
    title: "Brijo tells the story, aloud",
    text: "Every level starts with a short story. Brijo reads it to your child, and the words light up as she speaks.",
  },
  {
    image: "/images/app/badges.webp",
    alt: "Jabali's badges: one won, Feather Finder next",
    title: "Play, get help, win stars",
    text: "Children count, group and share bottle tops, mangoes and seeds. After a few wrong answers, gentle help steps in. Stars never go down.",
  },
];
/** Where each skill is practised, worked out from the level data. */
function skillFacts(name: string): { grades: string; count: number; example: string } {
  const key = Object.keys(SKILL_NAMES).find((k) => SKILL_NAMES[k] === name);
  const found = levels.flatMap((g) => g.levels.filter((l) => l.skill === key).map((l) => ({ grade: g.grade, eq: l.eq })));
  const grades = [...new Set(found.map((f) => f.grade))];
  const gradeText = grades.length === 1 ? `Grade ${grades[0]}` : `Grades ${grades.slice(0, -1).join(", ")} and ${grades.at(-1)}`;
  return { grades: gradeText, count: found.length, example: found[0]?.eq ?? "" };
}
const skills = [
  { name: "Making 10", text: "Fill ten-frames with bottle tops, shells and feathers, and see how 5 and more make 10." },
  { name: "Taking away", text: "Brijo takes some away, and the child counts what's left: from 7 − 2 up to 352 − 125." },
  { name: "Place value", text: "Pack tomatoes into crates of ten and boxes of a hundred to build numbers like 34 and 243." },
  { name: "Adding on", text: "Add by counting on, then add in columns, carrying a ten when the ones fill up." },
  { name: "Counting in steps", text: "Fill gaps on a number track, counting back from 50 and on in tens from 130." },
  { name: "Equal groups", text: "Plant seeds in equal holes and build arrays of rows, the first steps to multiplying." },
  { name: "Sharing equally", text: "Share tomatoes between monkeys and cut a chapati into equal pieces." },
  { name: "Telling the time", text: "Set the clock to o'clock in Grade 2, and to half past in Grade 3." },
];
---

<Base
  title="How it works"
  description="Every ArithmeTick level, grade by grade, and the eight maths skills children practise."
  current="how"
  schema={schema}
>
  <section class="hero" id="steps">
    <div class="container">
      <div class="head">
        <h1 class="display">One small level at a time.</h1>
        <p class="lede">Each grade is a jungle map of short levels built on Kenya's CBC maths curriculum. Here's what happens in one.</p>
        <div class="actions">
          <PlayButton />
          <a class="btn btn-outline" href="#levels">See every level</a>
        </div>
      </div>
      <div class="story" data-active="0">
      <div class="pinned" aria-hidden="true">
        <figure class="pinned-phone">
          {steps.map((step, i) => <img class:list={[i === 0 && "on"]} src={step.image} width="390" height="844" loading={i === 0 ? "eager" : "lazy"} alt="" />)}
        </figure>
        <div class="pinned-dots">{steps.map((_, i) => <span class:list={[i === 0 && "on"]} />)}</div>
      </div>
      <ol class="steps">
        {
          steps.map((step, i) => (
            <li class:list={["step", i === 0 && "active"]}>
              <figure class="shot">
                <img src={step.image} width="390" height="844" loading={i === 0 ? "eager" : "lazy"} alt={step.alt} />
              </figure>
              <div class="step-copy">
                <span class="step-n">Step {i + 1}</span>
                <h2 class="heading-sm">{step.title}</h2>
                <p class="body-xl">{step.text}</p>
              </div>
            </li>
          ))
        }
      </ol>
      </div>
    </div>
  </section>

  <section class="matrix" id="levels">
    <div class="container">
      <div class="section-head">
        <h2 class="heading-lg">Every level, grade by grade</h2>
        <p class="lede">Choose a grade to see its levels. Move & Play activities happen away from the screen, with a grown-up.</p>
      </div>
      <div class="tabs">
        {
          levels.map((g, i) => (
            <input type="radio" name="grade" id={`g${g.grade}`} checked={i === 0} class="visually-hidden" />
          ))
        }
        <div class="tab-row" role="presentation">
          {levels.map((g) => <label for={`g${g.grade}`}>Grade {g.grade}</label>)}
        </div>
        {
          levels.map((g) => (
            <div class={`panel p${g.grade}`}>
              <p class="grade-name">{GRADE_NAMES[g.grade]}</p>
              <ol class="level-list">
                {g.levels.map((l) => (
                  <li class={l.quest ? "quest" : ""}>
                    <span class="num">{l.n}</span>
                    <span class="what">
                      <strong>{l.title}</strong>
                      <span>{l.quest ? `Move & Play · ${l.eq}` : `${SKILL_NAMES[l.skill ?? ""]} · ${l.eq}`}</span>
                    </span>
                  </li>
                ))}
              </ol>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section class="skills" id="skills">
    <div class="pattern skills-pattern" aria-hidden="true"></div>
    <div class="container">
      <div class="skills-head">
        <h2 class="heading-lg">Eight skills, practised again and again</h2>
        <p class="lede">Each skill comes back across the grades, a little harder each time.</p>
      </div>
      <ol class="skill-list">
        {
          skills.map((skill, i) => {
            const facts = skillFacts(skill.name);
            return (
              <li class="skill">
                <span class="skill-n" aria-hidden="true">{String(i + 1).padStart(2, "0")}</span>
                <div class="skill-body">
                  <SkillArt index={i} />
                  <h3 class="heading-sm">{skill.name}</h3>
                  <p>{skill.text}</p>
                  <p class="skill-meta">
                    {facts.grades} · {facts.count} {facts.count === 1 ? "level" : "levels"}
                    {facts.example && <span class="eq">{facts.example}</span>}
                  </p>
                </div>
              </li>
            );
          })
        }
      </ol>
    </div>
  </section>

  <CtaBand
    title="Try it with your family."
    text="ArithmeTick is free during the beta. Install it from Google Play and play a few levels together."
  />
</Base>

<script>
  /* Skill drawings play once as each card comes into view, and again on hover or tap. */
  const skillCards = [...document.querySelectorAll<HTMLElement>(".skill")];
  const replay = (card: HTMLElement) => {
    card.classList.remove("play");
    void card.offsetWidth;
    card.classList.add("play");
  };
  if ("IntersectionObserver" in window) {
    const seen = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (entry.isIntersecting) {
            replay(entry.target as HTMLElement);
            seen.unobserve(entry.target);
          }
        }
      },
      { threshold: 0.6 },
    );
    skillCards.forEach((card) => seen.observe(card));
  }
  for (const card of skillCards) {
    card.addEventListener("mouseenter", () => replay(card));
    card.addEventListener("click", () => replay(card));
  }

  /* Pinned story (desktop): the step in the middle of the screen sets which screenshot the fixed phone shows. */
  const story = document.querySelector<HTMLElement>(".story");
  if (story && "IntersectionObserver" in window) {
    const steps = [...story.querySelectorAll<HTMLElement>(".step")];
    const shots = [...story.querySelectorAll<HTMLElement>(".pinned-phone img")];
    const dots = [...story.querySelectorAll<HTMLElement>(".pinned-dots span")];
    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (entry.isIntersecting) {
            const index = steps.indexOf(entry.target as HTMLElement);
            steps.forEach((el, i) => el.classList.toggle("active", i === index));
            shots.forEach((el, i) => el.classList.toggle("on", i === index));
            dots.forEach((el, i) => el.classList.toggle("on", i === index));
          }
        }
      },
      { rootMargin: "-45% 0px -45% 0px" },
    );
    for (const step of steps) {
      observer.observe(step);
    }
  }
</script>

<style>
  .hero {
    position: relative;
    overflow: clip;
    background: var(--cream);
    padding: 72px 0 80px;
  }
  .head {
    position: relative;
    max-width: 860px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 20px;
    text-align: center;
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 12px;
  }
  .steps {
    position: relative;
    margin: var(--space-12) 0 0;
    padding: 0;
    list-style: none;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-8);
  }
  .step {
    display: grid;
    gap: var(--space-5);
    align-content: start;
  }
  .shot {
    justify-self: center;
    width: min(220px, 70vw);
    margin: 0;
    padding: 6px;
    border-radius: 32px;
    background: var(--outline);
  }
  .shot img {
    display: block;
    width: 100%;
    height: auto;
    border-radius: 26px;
  }
  .step-copy {
    display: grid;
    gap: var(--space-2);
    text-align: center;
  }
  .step-n {
    color: var(--teal-700);
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .section-head {
    max-width: 700px;
    margin: 0 auto 32px;
    text-align: center;
    display: grid;
    gap: 12px;
  }
  .matrix {
    padding: var(--section-y) 0;
    scroll-margin-top: 80px;
  }
  .tab-row {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    border: 1px solid var(--line);
    border-bottom: 0;
    border-radius: var(--radius-md) var(--radius-md) 0 0;
    overflow: clip;
  }
  .tab-row label {
    padding: 16px;
    text-align: center;
    font-weight: 700;
    color: var(--teal-700);
    cursor: pointer;
    border-bottom: 2px solid var(--line);
  }
  #g1:checked ~ .tab-row label[for="g1"],
  #g2:checked ~ .tab-row label[for="g2"],
  #g3:checked ~ .tab-row label[for="g3"] {
    background: var(--sun-50);
    border-bottom-color: var(--teal-700);
    color: var(--ink);
  }
  #g1:focus-visible ~ .tab-row label[for="g1"],
  #g2:focus-visible ~ .tab-row label[for="g2"],
  #g3:focus-visible ~ .tab-row label[for="g3"] {
    outline: 3px solid var(--purple-500);
    outline-offset: -3px;
  }
  .panel {
    display: none;
    padding: 24px;
    border: 1px solid var(--line);
    border-top: 0;
    border-radius: 0 0 var(--radius-md) var(--radius-md);
  }
  #g1:checked ~ .p1,
  #g2:checked ~ .p2,
  #g3:checked ~ .p3 {
    display: block;
  }
  .grade-name {
    font-size: 20px;
    font-weight: 700;
    color: var(--teal-700);
    margin-bottom: 16px;
  }
  .level-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 12px;
  }
  .level-list li {
    display: flex;
    gap: 14px;
    align-items: center;
    padding: 12px 14px;
    border-radius: var(--radius-md);
    background: var(--mint-50);
  }
  .level-list li.quest {
    background: var(--purple-50);
  }
  .num {
    flex: none;
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    border-radius: 12px;
    background: var(--teal-700);
    color: var(--white);
    font-weight: 700;
  }
  .quest .num {
    background: var(--purple-600);
  }
  .what {
    display: flex;
    flex-direction: column;
    min-width: 0;
    font-size: 15px;
    color: var(--muted);
  }
  .what strong {
    font-size: 17px;
    color: var(--text);
  }
  .skills {
    position: relative;
    overflow: clip;
    background: var(--ink);
    padding: var(--section-y) 0;
  }
  .skills-pattern {
    position: absolute;
    inset: 0;
    opacity: 0.12;
  }
  .skills .container {
    position: relative;
    display: grid;
    gap: var(--space-10);
  }
  .skills-head {
    display: grid;
    gap: var(--space-3);
    max-width: 640px;
  }
  .skills h2 {
    color: var(--white);
  }
  .skills .lede {
    color: var(--mint-100);
  }
  .skill-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    column-gap: var(--space-12);
    counter-reset: none;
  }
  .skill {
    display: grid;
    grid-template-columns: 56px minmax(0, 1fr);
    gap: var(--space-4);
    padding: var(--space-6) 0;
    border-top: 1px solid rgba(255, 255, 255, 0.18);
  }
  .skill-n {
    color: var(--sun);
    font-size: 28px;
    font-weight: 800;
    line-height: 1.1;
    font-variant-numeric: tabular-nums;
  }
  .skill-body {
    display: grid;
    gap: var(--space-2);
  }
  .skill h3 {
    color: var(--white);
  }
  .skill-body > p {
    color: var(--mint-100);
    font-size: 17px;
  }
  .skill-body > p.skill-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2) var(--space-3);
    margin-top: var(--space-1);
    color: var(--white);
    font-size: 14px;
    font-weight: 700;
  }
  .eq {
    padding: 2px 10px;
    border-radius: var(--radius-sm);
    background: rgba(255, 255, 255, 0.1);
    color: var(--yellow-soft);
    font-weight: 600;
    font-variant-numeric: tabular-nums;
  }
  @media (max-width: 900px) {
    .steps,
    .skill-list {
      grid-template-columns: 1fr;
    }
  }
  /* Pinned story: on wide screens one phone stays put while the steps scroll past beside it. */
  .pinned {
    display: none;
  }
  @media (min-width: 900px) {
    .story {
      display: grid;
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      gap: var(--space-16);
      margin-top: var(--space-12);
    }
    .pinned {
      position: sticky;
      /* Centred in the space under the nav, so the phone is never cut off at the top. */
      top: max(76px, calc(60px + (100vh - 60px - 580px) / 2));
      display: grid;
      justify-items: center;
      gap: var(--space-5);
      align-self: start;
    }
    .pinned-phone {
      position: relative;
      /* Shrinks on short screens so the whole phone and its dots fit below the nav. */
      width: min(240px, calc((100vh - 150px) * 390 / 844));
      aspect-ratio: 390 / 844;
      margin: 0;
      padding: 6px;
      border-radius: 34px;
      background: var(--outline);
      box-shadow: 0 30px 60px rgb(0 79 74 / 0.2);
    }
    .pinned-phone img {
      position: absolute;
      inset: 6px;
      width: calc(100% - 12px);
      height: calc(100% - 12px);
      border-radius: 28px;
      opacity: 0;
      scale: 1.04;
      transition:
        opacity 0.5s ease,
        scale 0.6s cubic-bezier(0.16, 1, 0.3, 1);
    }
    .pinned-phone img.on {
      opacity: 1;
      scale: 1;
    }
    .pinned-dots {
      display: flex;
      gap: 8px;
    }
    .pinned-dots span {
      width: 8px;
      height: 8px;
      border-radius: 4px;
      background: var(--line);
      transition:
        width 0.3s ease,
        background-color 0.3s ease;
    }
    .pinned-dots span.on {
      width: 28px;
      background: var(--teal-700);
    }
    .story .steps {
      grid-template-columns: 1fr;
      gap: 0;
      margin: 0;
    }
    .story .step {
      min-height: 70vh;
      align-content: center;
    }
    .story .step-copy {
      opacity: 0.3;
      transition: opacity 0.4s ease;
    }
    .story .step.active .step-copy {
      opacity: 1;
    }
    .story .step .shot {
      display: none;
    }
    .story .step-copy {
      text-align: left;
      max-width: 440px;
    }
    .story .step-copy .heading-sm {
      font-size: clamp(28px, 3vw, 40px);
    }
  }
  /* The map's dotted trail joins the three steps: a faint trail, a teal one that fills in as you
     scroll (CSS only, so it moves smoothly), and a numbered stop at each step that lights up. */
  @media (min-width: 900px) {
    .story .steps {
      position: relative;
      padding-left: 72px;
    }
    .story .steps::before,
    .story .steps::after {
      content: "";
      position: absolute;
      left: 22px;
      top: 35vh;
      bottom: 35vh;
      width: 6px;
      border-radius: 3px;
      background: radial-gradient(circle, currentColor 2.5px, transparent 3px) 50% 0 / 6px 16px repeat-y;
    }
    .story .steps::before {
      color: rgb(0 111 104 / 0.2);
    }
    .story .steps::after {
      color: var(--teal-600);
      clip-path: inset(0 0 100% 0);
    }
    .story .step {
      position: relative;
      counter-increment: trail;
    }
    .story .steps {
      counter-reset: trail;
    }
    .story .step::before {
      content: counter(trail);
      position: absolute;
      z-index: 1;
      left: -72px;
      top: 50%;
      display: grid;
      place-items: center;
      width: 50px;
      height: 50px;
      margin-top: -25px;
      border: 3px solid rgb(0 111 104 / 0.25);
      border-radius: 50%;
      background: var(--white);
      color: var(--muted);
      font-size: 20px;
      font-weight: 800;
      transition:
        background-color 0.3s ease,
        border-color 0.3s ease,
        color 0.3s ease,
        scale 0.3s ease;
    }
    .story .step.active::before {
      border-color: var(--ink);
      background: var(--sun);
      color: var(--ink);
      scale: 1.12;
    }
  }
  @media (min-width: 900px) and (prefers-reduced-motion: no-preference) {
    @supports (animation-timeline: view()) {
      .story .steps::after {
        animation-name: trail-fill;
        animation-timing-function: linear;
        animation-fill-mode: both;
        animation-timeline: view();
        animation-range: cover 25% cover 75%;
      }
    }
  }
  @media (min-width: 900px) and (prefers-reduced-motion: reduce) {
    .story .steps::after {
      clip-path: none;
    }
  }
  @supports not (animation-timeline: view()) {
    .story .steps::after {
      clip-path: none;
    }
  }
  @keyframes trail-fill {
    to {
      clip-path: inset(0 0 0 0);
    }
  }
  @media (min-width: 900px) and (prefers-reduced-motion: reduce) {
    .pinned-phone img,
    .story .step-copy {
      transition: none;
    }
  }
</style>
