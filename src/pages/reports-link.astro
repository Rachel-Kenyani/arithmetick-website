---
import Base from "../layouts/Base.astro";
import Owl from "../components/Owl.astro";
import { SUPPORT_EMAIL } from "../data/site";
---

<Base title="That link didn't work" description="The link to turn off ArithmeTick's weekly reports didn't work." noindex>
  <section class="container done">
    <Owl size={120} />
    <h1 class="display">That link didn't work</h1>
    <p class="lede">Your weekly reports are still on. The link may have been copied only in part.</p>
    <p class="note">Turn them off in the app instead: hold the gear on “Who is playing today?”, then use the <strong>Weekly reports</strong> switch. Or email <a href={`mailto:${SUPPORT_EMAIL}`}>{SUPPORT_EMAIL}</a> and we'll do it for you.</p>
    <a class="btn btn-primary" href="/">Go to the home page</a>
  </section>
</Base>

<style>
  .done { display: grid; justify-items: center; gap: 18px; padding-top: 72px; padding-bottom: 96px; text-align: center; }
  .note { max-width: 46ch; margin: 0; }
</style>
