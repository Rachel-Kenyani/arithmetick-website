---
import Base from "../layouts/Base.astro";
import PlayButton from "../components/PlayButton.astro";
import Faq from "../components/Faq.astro";
import { SUPPORT_EMAIL as EMAIL } from "../data/site";
import { FAQ, HELP_FAQ } from "../data/faq";

const questions = [...HELP_FAQ, ...FAQ];
const schema = [
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: questions.map((f) => ({ "@type": "Question", name: f.question, acceptedAnswer: { "@type": "Answer", text: f.answer } })),
  },
];
---

<Base title="Contact us" description="Get ArithmeTick on Google Play, or get in touch with a question." current="contact" schema={schema}>
  <section class="hero">
    <div class="pattern hero-pattern" aria-hidden="true"></div>
    <div class="container head">
      <h1 class="display">Get in touch</h1>
      <p class="lede">Get the app, ask a question, or tell us what your child thinks of Brijo.</p>
    </div>
  </section>

  <section class="container grid">
    <article class="card beta" id="beta">
      <p class="tag">Free during the beta</p>
      <h2 class="heading-lg">Get the app</h2>
      <p class="body-xl">ArithmeTick is on Google Play for Android phones. Install it, create a grown-up account, and add up to 4 children.</p>
      <PlayButton />
    </article>

    <article class="card">
      <h2 class="heading-lg">Questions and help</h2>
      <p class="tip"><strong>Using the app?</strong> The quickest way to report a problem is in the app: hold the gear on “Who is playing today?”, then tap <strong>Report a problem</strong>.</p>
      <p class="body-xl">For other questions, or anything about your family's data, email:</p>
      <p class="email">
        <span id="email-text">{EMAIL}</span>
        <button type="button" class="copy" data-copy={EMAIL}>Copy</button>
      </p>
      <p class="body-xl">We reply within a few days.</p>
      <ul class="links">
        <li><a href="#faq">Common questions</a></li>
        <li><a href="/privacy">Privacy Policy</a></li>
      </ul>
    </article>
  </section>

  <Faq
    groups={[
      { title: "Using the app", items: HELP_FAQ },
      { title: "Before you install", items: FAQ },
    ]}
    title="Common questions"
    openFirst={false}
    lede="Most answers are here. If yours isn't, email us."
  />
</Base>

<script>
  for (const button of document.querySelectorAll<HTMLButtonElement>("button[data-copy]")) {
    button.addEventListener("click", async () => {
      try {
        await navigator.clipboard.writeText(button.dataset.copy ?? "");
        button.textContent = "Copied";
      } catch {
        const range = document.createRange();
        const text = document.getElementById("email-text");
        if (text) {
          range.selectNodeContents(text);
          getSelection()?.removeAllRanges();
          getSelection()?.addRange(range);
        }
        button.textContent = "Selected";
      }
      setTimeout(() => (button.textContent = "Copy"), 2000);
    });
  }
</script>

<style>
  .hero {
    position: relative;
    overflow: hidden;
    background: var(--mint-50);
    padding: 64px 0;
  }
  .hero-pattern {
    position: absolute;
    inset: 0;
    opacity: 0.5;
  }
  .head {
    position: relative;
    display: grid;
    gap: 16px;
    text-align: center;
    justify-items: center;
  }
  .grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 24px;
    padding-top: 48px;
    padding-bottom: 80px;
  }
  .card {
    display: flex;
    flex-direction: column;
    gap: 16px;
    min-width: 0;
    padding: 40px;
    border-radius: var(--radius-lg);
    background: var(--white);
    border: 1px solid var(--line);
    scroll-margin-top: 100px;
  }
  .card h2 {
    color: var(--teal-700);
  }
  .tag {
    padding: 0;
    background: none;
    color: var(--purple-600);
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .card :global(.btn) {
    align-self: flex-start;
    margin-top: 8px;
  }
  .tip {
    padding: 14px 16px;
    border-radius: var(--radius-md);
    background: #fff4cc;
    font-size: 17px;
    color: var(--ink);
  }
  .email {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px;
    padding: 14px 16px;
    border-radius: var(--radius-md);
    background: var(--mint-50);
    font-weight: 700;
    color: var(--ink);
    word-break: break-all;
  }
  .copy {
    font: inherit;
    font-size: 15px;
    padding: 6px 14px;
    border-radius: var(--radius-sm);
    border: 2px solid var(--teal-700);
    background: var(--white);
    color: var(--teal-700);
    cursor: pointer;
  }
  .links {
    margin: 0;
    padding-left: 20px;
    display: grid;
    gap: 6px;
  }
  @media (max-width: 800px) {
    .grid {
      grid-template-columns: 1fr;
    }
    .card {
      padding: 28px;
    }
  }
</style>
