---
import { CLOUDFLARE_ANALYTICS_TOKEN, SUPPORT_EMAIL as EMAIL } from "../data/site";
import Doc from "../layouts/Doc.astro";
const toc = [
  { id: "short", label: "The short version" },
  { id: "who", label: "Who we are" },
  { id: "collect", label: "What we collect" },
  { id: "reports", label: "Weekly email reports" },
  { id: "children", label: "Children" },
  { id: "others", label: "Who else handles it" },
  { id: "outside", label: "Stored outside Kenya" },
  { id: "keep", label: "How long we keep it" },
  { id: "rights", label: "Your rights" },
  { id: "safe", label: "Keeping it safe" },
