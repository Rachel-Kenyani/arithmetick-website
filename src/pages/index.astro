---
import Base from "../layouts/Base.astro";
import FeatureCard from "../components/FeatureCard.astro";
import CtaBand from "../components/CtaBand.astro";
import PlayButton from "../components/PlayButton.astro";
import ProductVideo from "../components/ProductVideo.astro";
import fs from "node:fs";
import { FAQ, HOME_FAQ } from "../data/faq";
import Faq from "../components/Faq.astro";
import TryLevel from "../components/TryLevel.astro";
import SkillBand from "../components/SkillBand.astro";
import levels from "../data/levels.json";
import { PLAY_STORE_URL, ANDROID_PACKAGE } from "../data/site";

const F = "/images/figma/";
/** Counted from the level data, so they stay right when levels change. */
const stats = [
  { value: levels.reduce((sum, g) => sum + g.levels.length, 0), label: "levels on the map" },
  { value: 8, label: "maths skills" },
  { value: levels.length, label: "grades, 1 to 3" },
];
const hasTour = fs.existsSync(`${process.cwd()}/public/video/arithmetick-tour.mp4`);
const schema = [
  {
    "@context": "https://schema.org",
    "@type": "MobileApplication",
    name: "ArithmeTick",
    operatingSystem: "Android",
    applicationCategory: "EducationalApplication",
    identifier: ANDROID_PACKAGE,
    installUrl: PLAY_STORE_URL,
    description: "Maths games for Grades 1 to 3. Brijo the owl reads every instruction aloud, so children can play before they can read.",
    screenshot: ["/images/app/map.jpg", "/images/app/level.jpg", "/images/app/badges.jpg"].map((p) => new URL(p, Astro.site).href),
    offers: { "@type": "Offer", price: "0", priceCurrency: "KES" },
    audience: { "@type": "EducationalAudience", educationalRole: "student", audienceType: "Children in Grades 1 to 3, ages 6 to 9" },
    educationalLevel: "Grades 1 to 3",
    educationalAlignment: { "@type": "AlignmentObject", alignmentType: "educationalSubject", educationalFramework: "Kenya Competency-Based Curriculum (CBC)", targetName: "Mathematics, Grades 1 to 3" },
    teaches: FAQ.at(-1)?.answer,
    inLanguage: "en-KE",
    author: { "@type": "Person", name: "Rachel Kenyani" },
  },
];
/** The four animals a child can choose, in the order the app shows them. */
const animals = ["Owl", "Cheetah", "Bear", "Fox"];
const moveAndPlay = [
  {
    grade: "Grade 1",
    title: "Find It",
    text: "Find six things at home that are the same, line them up and count them together.",
    focus: "counting objects",
  },
  {
    grade: "Grade 2",
    title: "Market Day",
    text: "Play shop with real shillings: pay for a cup of maize and count up to work out the change.",
    focus: "money and change",
  },
  {
    grade: "Grade 3",
    title: "Treasure Walk",
    text: "Hide a treasure and guide a grown-up to it with directions: forward 3 steps, turn left.",
    focus: "position and direction",
  },
];
---

<Base
  title="ArithmeTick"
  description="Playful Grade 1 to 3 maths for Kenyan families. Brijo the owl reads every instruction aloud, children count real things, and grown-ups join in."
  current="home"
  schema={schema}
>
  <section class="hero">
    <div class="pattern hero-pattern" aria-hidden="true"></div>
    <div class="container hero-grid">
      <div class="hero-copy">
        <ul class="facts" aria-label="At a glance">
          <li>CBC Grades 1 to 3</li>
          <li>Ages 6 to 9</li>
          <li class="mint">Free during the beta</li>
          <li class="lilac">Daily limit you set</li>
        </ul>
        <h1 class="display headline">
          {"Turn screen time into maths confidence.".split(" ").map((w, i) => (
            <span class="word"><span style={`--i:${i}`}>{w}</span></span>
          ))}
        </h1>
        <p class="lede">
          Short maths games for Grades 1 to 3. Brijo the owl reads every instruction aloud, so children can play before
          they can read.
        </p>
        <div class="actions">
          <PlayButton />
          <a class="btn btn-outline" href={hasTour ? "#tour" : "/how-it-works"}>
            <img src={F + "play-circle.svg"} width="24" height="24" alt="" />
            {hasTour ? "Watch the tour" : "See how it works"}
          </a>
        </div>
        <p class="trust">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3 4.5 6v5.5c0 4.5 3.2 8.4 7.5 9.5 4.3-1.1 7.5-5 7.5-9.5V6z"></path><path d="m9 12 2 2 4-4"></path></svg>
          <span>No ads, and we never sell your family's data. Progress is saved with your account, for your eyes only. <a href="/privacy">Privacy</a></span>
        </p>
      </div>
      <div class="hero-art" aria-label="Screens from the ArithmeTick app">
        <figure class="tablet">
          <img src="/images/app/grade3-tablet.webp" width="800" height="1280" alt="A Grade 3 level on a tablet: 352 − 125 worked in columns, borrowing a ten, with bottle tops to count" />
        </figure>
        <figure class="phone back">
          <img src="/images/app/level.webp" width="390" height="844" alt="A level: Brijo asks the child to collect 7 feathers" />
        </figure>
        <figure class="phone front">
          <img src="/images/app/map.webp" width="390" height="844" alt="The jungle map of Grade 1 levels" />
        </figure>
      </div>
    </div>
  </section>

  <section class="pillars-section">
    <div class="container pillars">
      <div class="section-head">
        <h2 class="heading-lg">Maths doesn't have to be a chore</h2>
        <p class="lede">Every level is real Grade 1 to 3 maths, built to feel like a game a child wants to play again.</p>
      </div>
      <div class="cards">
        <FeatureCard icon={F + "phone.svg"} title="Screen time you can feel good about" note="You choose the daily limit">
          Each level practises a skill from Kenya's CBC maths curriculum for Grades 1 to 3, and a daily time limit you choose keeps play short.
        </FeatureCard>
        <FeatureCard icon={F + "puzzle.svg"} title="Low-anxiety, playful learning" tone="purple" note="Gentle hints, never a lost star">
          Brijo guides children through mistakes with gentle hints. A wrong answer never costs stars.
        </FeatureCard>
        <FeatureCard icon={F + "chart.svg"} title="See how they're doing" tone="sun" note="An optional weekly email for grown-ups">
          Turn on a weekly email: levels, stars, what they're strong at, and one game to try at home.
        </FeatureCard>
      </div>
    </div>
  </section>

  <SkillBand />

  <TryLevel />

  <ProductVideo
    title="One level, start to finish"
    text="A minute of real play: Brijo sets the task, the child counts, and the stars come in."
    points={[
      "Brijo reads the instruction aloud and the words light up.",
      "The child taps, drags and counts real things.",
      "A wrong answer gets a gentle hint, never a lost star.",
    ]}
  />

  <section class="split kids-band">
    <div class="container split-grid">
      <div class="row">
        <div class="mock kids-mock">
          <div class="tilt teal" aria-hidden="true"></div>
          <figure class="phone md">
            <img src="/images/app/badges.webp" width="390" height="844" loading="lazy" alt="Jabali's badges: 1 of 18 won, with Feather Finder next up" />
          </figure>
        </div>
        <div class="copy">
          <p class="overline label teal-text">For kids</p>
          <h2 class="heading-lg">A learning adventure they actually ask to play</h2>
          <p class="lede">Stories set in a Kenyan home and market turn numbers into things children can see and touch.</p>
          <ul class="ticks">
            <li><span class="tick teal"><img src={F + "route.svg"} width="22" height="22" alt="" /></span><span><strong>A jungle map of short levels.</strong> One small step at a time, so every session ends with a win.</span></li>
            <li><span class="tick purple"><img src={F + "award.svg"} width="22" height="22" alt="" /></span><span><strong>Stars, badges and a family goal.</strong> Children win them alone and celebrate them together.</span></li>
            <li><span class="tick sun"><img src={F + "calculator.svg"} width="22" height="22" alt="" /></span><span><strong>Real things to count.</strong> Bottle tops, mangoes, seeds and chapati make numbers concrete.</span></li>
          </ul>
          <dl class="stats">
            {
              stats.map((st) => (
                <div>
                  <dt>{st.label}</dt>
                  <dd data-count={st.value}>{st.value}</dd>
                </div>
              ))
            }
          </dl>
        </div>
      </div>
      <div class="animals">
        <div class="animals-copy">
          <h3 class="heading-sm">Choose your animal</h3>
          <p>Each child picks an owl, cheetah, bear or fox for their profile, so they always know which map is theirs.</p>
        </div>
        <ul class="animal-row">
          {
            animals.map((a) => (
              <li>
                <img src={`/images/animals/${a.toLowerCase()}.webp`} width="400" height="413" loading="lazy" alt="" />
                <span>{a}</span>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </section>

  <section class="split">
    <div class="container split-grid">
      <div class="row reverse">
        <div class="copy">
          <p class="overline label purple-text">For parents</p>
          <h2 class="heading-lg">Stay connected without hovering</h2>
          <p class="lede">See where your child is growing without sitting over their shoulder.</p>
          <ul class="ticks">
            <li><span class="tick purple"><img src={F + "user-plus.svg"} width="22" height="22" alt="" /></span><span><strong>A profile for each child.</strong> Up to 4 children, each with their own map and stars.</span></li>
            <li><span class="tick teal"><img src={F + "chart-purple.svg"} width="22" height="22" alt="" /></span><span><strong>A weekly email, if you want it.</strong> What they're strong at, and one game to try at home.</span></li>
            <li><span class="tick sun"><img src={F + "graduation.svg"} width="22" height="22" alt="" /></span><span><strong>Settings behind a 2-second hold.</strong> Small fingers can't change them by accident.</span></li>
          </ul>
        </div>
        <div class="mock parents-mock">
          <div class="tilt purple" aria-hidden="true"></div>
          <figure class="phone md">
            <img src="/images/app/report.webp" width="390" height="844" loading="lazy" alt="The weekly report email open on a phone: Jabali did 3 levels and earned 9 stars, making 10 is strong, and an idea to try at home with bottle tops" />
          </figure>
        </div>
      </div>
    </div>
  </section>

  <section class="move">
    <div class="pattern move-pattern" aria-hidden="true"></div>
    <div class="container">
      <div class="section-head">
        <p class="overline purple-text">Move & Play</p>
        <h2 class="heading-lg">Maths away from the screen</h2>
        <p class="lede">Every few levels, a Move & Play activity takes the maths into the home, with a grown-up.</p>
      </div>
      <div class="move-cards">
        {
          moveAndPlay.map((m, i) => (
            <article class={`move-card c${i}`}>
              <span class="tag">{m.grade}</span>
              <h3 class="heading-sm">{m.title}</h3>
              <p>{m.text}</p>
              <p class="focus">Focus: {m.focus}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <Faq items={HOME_FAQ} moreHref="/contact#faq" />

  <CtaBand
    title="Give your child the gift of maths confidence."
    text="ArithmeTick is free during the beta. Install it from Google Play and try it with your family tonight."
  />
</Base>

<script>
  /* The kids-section numbers count up from zero the first time they come into view. */
  const counters = [...document.querySelectorAll<HTMLElement>("[data-count]")];
  const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
  if (counters.length && !reduceMotion && "IntersectionObserver" in window) {
    const countUp = (el: HTMLElement) => {
      const target = Number(el.dataset.count);
      const start = performance.now();
      const step = (now: number) => {
        const t = Math.min((now - start) / 900, 1);
        el.textContent = String(Math.round(target * (1 - (1 - t) ** 3)));
        if (t < 1) {
          requestAnimationFrame(step);
        }
      };
      requestAnimationFrame(step);
    };
    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (entry.isIntersecting) {
            observer.unobserve(entry.target);
            countUp(entry.target as HTMLElement);
          }
        }
      },
      { threshold: 0.6 },
    );
    for (const el of counters) {
      observer.observe(el);
    }
  }
</script>

<style>
  .hero {
    position: relative;
    overflow: clip;
    /* Figma colour style "Landscape 3": a dark-to-clear layer over a purple-to-dark layer, so the
       corners are dark and a lighter purple band runs across the middle. */
    background:
      linear-gradient(160deg, var(--purple-950) 0%, rgb(109 65 163 / 0) 80%),
      linear-gradient(160deg, var(--purple-600) 0%, var(--purple-950) 80%);
    color: var(--white);
    /* The see-through nav sits on top of the hero, so make room for it. */
    padding: calc(var(--section-y) + 72px) 0 var(--section-y);
  }
  .hero-pattern {
    position: absolute;
    inset: 0;
    opacity: 0.12;
  }
  .hero h1 {
    color: var(--white);
  }
  /* Headline: each word slides up out of its own line, one after another, on load.
     Only the words move, never their opacity, so the headline still paints straight away. */
  .headline .word {
    display: inline-block;
    overflow: clip;
    overflow-clip-margin: 0.1em;
    padding-bottom: 0.08em;
    margin-bottom: -0.08em;
    vertical-align: top;
  }
  .headline .word > span {
    display: inline-block;
    white-space: pre;
    animation: word-up 0.8s cubic-bezier(0.16, 1, 0.3, 1) both;
    animation-delay: calc(var(--i) * 70ms + 100ms);
  }
  .headline .word:not(:last-child) > span::after {
    content: " ";
  }
  @keyframes word-up {
    from {
      translate: 0 110%;
      rotate: 4deg;
    }
  }
  /* "confidence." ticks in like a counter settling: a quick overshoot, ArithmeTick's tick. */
  .headline .word:last-child > span {
    color: var(--sun);
    animation:
      word-up 0.8s cubic-bezier(0.16, 1, 0.3, 1) both,
      tick 0.5s steps(4) both;
    animation-delay:
      calc(var(--i) * 70ms + 100ms),
      calc(var(--i) * 70ms + 650ms);
  }
  @keyframes tick {
    25% {
      rotate: -6deg;
    }
    50% {
      rotate: 4deg;
    }
    75% {
      rotate: -2deg;
    }
    to {
      rotate: 0deg;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .headline .word > span {
      animation: none !important;
    }
  }
  /* Hero phones drift apart and tilt as the page scrolls away: depth without a script. */
  @media (prefers-reduced-motion: no-preference) {
    @supports (animation-timeline: scroll()) {
      .hero-art .phone.back,
      .hero-art .phone.front {
        animation-timing-function: linear;
        animation-fill-mode: both;
        animation-timeline: scroll(root);
        animation-range: 0 90vh;
      }
      .hero-art .phone.back {
        animation-name: drift-back;
      }
      .hero-art .phone.front {
        animation-name: drift-front;
      }
    }
  }
  @keyframes drift-back {
    to {
      translate: 30px -90px;
      rotate: 11deg;
    }
  }
  @keyframes drift-front {
    to {
      translate: -30px -30px;
      rotate: -10deg;
    }
  }

  .hero .lede {
    color: #e4d6f7;
  }
  .hero :focus-visible {
    outline-color: var(--white);
  }
  .hero .actions :global(.btn-outline) {
    background: transparent;
    color: var(--white);
    border-color: var(--white);
  }
  .hero .actions :global(.btn-outline:hover) {
    background: rgba(255, 255, 255, 0.12);
  }
  .hero .actions :global(.btn-outline img) {
    filter: brightness(0) invert(1);
  }
  .hero-grid {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: 40px;
    align-items: center;
  }
  .hero-copy {
    display: flex;
    flex-direction: column;
    gap: 24px;
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 16px;
  }
  .actions :global(.btn) {
    flex: 0 1 auto;
    white-space: nowrap;
  }
  @media (max-width: 480px) {
    .actions :global(.btn) {
      flex: 1 1 100%;
    }
  }
  .trust {
    display: flex;
    align-items: flex-start;
    gap: var(--space-2);
    color: var(--white);
    font-size: 15px;
    font-weight: 600;
  }
  .trust a {
    color: var(--white);
  }
  .trust svg {
    flex: none;
    margin-top: 1px;
    color: var(--mint-100);
  }
  .facts {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .facts li {
    padding: 4px 12px;
    border-radius: var(--radius-pill);
    background: transparent;
    border: 1px solid rgba(255, 255, 255, 0.4);
    color: var(--white);
    font-size: 14px;
    font-weight: 600;
  }
  .facts li.mint {
    background: var(--mint-100);
    border-color: var(--mint-100);
    color: var(--ink);
  }
  .facts li.lilac {
    background: var(--purple-100);
    border-color: var(--purple-100);
    color: var(--purple-700);
  }
  .hero-art {
    position: relative;
    height: 560px;
  }
  /* Hero: a Grade 3 tablet stands at the back, with the two Grade 1 phones in front of it. */
  .tablet {
    position: absolute;
    left: 50%;
    top: 0;
    z-index: 0;
    width: 300px;
    margin: 0 0 0 -150px;
    padding: 10px;
    border-radius: 30px;
    background: var(--text);
    box-shadow: 0 16px 40px rgb(0 0 0 / 0.28);
  }
  .tablet img {
    display: block;
    width: 100%;
    height: auto;
    border-radius: 20px;
  }
  .phone {
    position: absolute;
    margin: 0;
    width: 220px;
    border-radius: 32px;
    overflow: clip;
    border: 6px solid var(--text);
    background: var(--text);
    box-shadow: 0 8px 24px rgba(0, 107, 98, 0.18);
  }
  .phone img {
    display: block;
    width: 100%;
    height: auto;
    border-radius: 26px;
  }
  .hero-art .phone {
    width: 170px;
  }
  .phone.front {
    left: 0;
    top: 150px;
    rotate: -6deg;
    z-index: 2;
  }
  .phone.back {
    right: 0;
    top: 190px;
    rotate: 6deg;
    z-index: 1;
  }




  .pillars-section {
    padding: var(--section-y) 0;
    border-top: 1px solid var(--line);
  }
  .pillars {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 40px;
  }
  .section-head {
    display: flex;
    flex-direction: column;
    gap: 12px;
    max-width: 700px;
    margin: 0 auto;
    text-align: center;
  }
  .cards {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 24px;
  }

  .split {
    padding: var(--section-y) 0;
    overflow-x: clip;
  }
  .split-grid {
    display: flex;
    flex-direction: column;
    gap: 80px;
  }
  .row {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: 40px;
    align-items: center;
  }
  .copy {
    display: flex;
    flex-direction: column;
    gap: 24px;
  }
  .kids-band {
    background: var(--mint-50);
  }
  .stats {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4) var(--space-10);
    margin: var(--space-2) 0 0;
    padding-top: var(--space-6);
    border-top: 1px solid var(--line);
  }
  .stats div {
    display: flex;
    flex-direction: column-reverse;
  }
  .stats dt {
    color: var(--muted);
    font-size: 15px;
  }
  .stats dd {
    margin: 0;
    color: var(--teal-700);
    font-size: clamp(36px, 4vw, 48px);
    font-weight: 800;
    line-height: 1.1;
    font-variant-numeric: tabular-nums;
  }
  .animals {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.6fr);
    gap: var(--space-8);
    align-items: center;
    margin-top: var(--space-16);
    padding-top: var(--space-12);
    border-top: 1px solid var(--line);
  }
  .animals-copy {
    display: grid;
    gap: var(--space-2);
  }
  .animals-copy p {
    color: var(--muted);
  }
  .animal-row {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: var(--space-4);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .animal-row li {
    display: grid;
    gap: var(--space-2);
    justify-items: center;
    font-weight: 700;
    color: var(--ink);
  }
  .animal-row img {
    display: block;
    width: 100%;
    height: auto;
  }
  @media (max-width: 900px) {
    .animals {
      grid-template-columns: 1fr;
      margin-top: var(--space-12);
      padding-top: var(--space-10);
    }
  }
  @media (max-width: 480px) {
    .animal-row {
      gap: var(--space-2);
      font-size: 15px;
    }
  }
  .label {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    margin-bottom: calc(-1 * var(--space-2));
  }
  .teal-text {
    color: var(--teal-700);
  }
  .purple-text {
    color: var(--purple-600);
  }
  .ticks {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--space-5);
  }
  .ticks li {
    display: flex;
    gap: var(--space-4);
    align-items: flex-start;
    color: var(--muted);
    font-size: 17px;
  }
  .ticks strong {
    color: var(--ink);
  }
  .tick {
    flex: none;
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    border-radius: var(--radius-sm);
    background: var(--mint-100);
  }
  .tick.purple {
    background: var(--purple-100);
  }
  .tick.sun {
    background: var(--sun-50);
  }
  .mock {
    position: relative;
    display: grid;
    place-items: center;
    padding: var(--space-8) var(--space-6);
  }
  /* The Figma "For Kids" and "For Parents" backdrops: the triangle row, tinted, repeated over a solid colour. */
  .tilt.teal {
    background: var(--mint-100) url("/images/pattern-row-teal.svg") center top / 1789px 88.5px repeat;
  }
  .tilt.purple {
    background: var(--purple-100) url("/images/pattern-row-purple.svg") center top / 1789px 88.5px repeat;
  }
  .phone.md {
    position: relative;
