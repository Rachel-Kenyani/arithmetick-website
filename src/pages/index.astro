---
import Base from "../layouts/Base.astro";
import FeatureCard from "../components/FeatureCard.astro";
import CtaBand from "../components/CtaBand.astro";
import PlayButton from "../components/PlayButton.astro";
import ProductVideo from "../components/ProductVideo.astro";
import fs from "node:fs";
import { FAQ } from "../data/faq";
import Faq from "../components/Faq.astro";
import { PLAY_STORE_URL, ANDROID_PACKAGE } from "../data/site";

const F = "/images/figma/";
const hasTour = fs.existsSync(`${process.cwd()}/public/video/arithmetick-tour.mp4`);
const schema = [
  {
    "@context": "https://schema.org",
    "@type": "MobileApplication",
    name: "ArithmeTick",
    operatingSystem: "Android",
    applicationCategory: "EducationalApplication",
    identifier: ANDROID_PACKAGE,
    installUrl: PLAY_STORE_URL,
    description: "Maths games for Grades 1 to 3. Brijo the owl reads every instruction aloud, so children can play before they can read.",
    screenshot: ["/images/app/map.jpg", "/images/app/level.jpg", "/images/app/badges.jpg"].map((p) => new URL(p, Astro.site).href),
    offers: { "@type": "Offer", price: "0", priceCurrency: "KES" },
    audience: { "@type": "EducationalAudience", educationalRole: "student", audienceType: "Children in Grades 1 to 3, ages 6 to 9" },
    educationalLevel: "Grades 1 to 3",
    educationalAlignment: { "@type": "AlignmentObject", alignmentType: "educationalSubject", educationalFramework: "Kenya Competency-Based Curriculum (CBC)", targetName: "Mathematics, Grades 1 to 3" },
    teaches: FAQ.at(-1)?.answer,
    inLanguage: "en",
    author: { "@type": "Person", name: "Rachel Kenyani" },
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: FAQ.map((f) => ({ "@type": "Question", name: f.question, acceptedAnswer: { "@type": "Answer", text: f.answer } })),
  },
];
const moveAndPlay = [
  {
    grade: "Grade 1",
    title: "Find It",
    text: "Find six things at home that are the same, line them up and count them together.",
  },
  {
    grade: "Grade 2",
    title: "Market Day",
    text: "Play shop with real shillings: pay for a cup of maize and count up to work out the change.",
  },
  {
    grade: "Grade 3",
    title: "Treasure Walk",
    text: "Hide a treasure and guide a grown-up to it with directions: forward 3 steps, turn left.",
  },
];
---

<Base
  title="ArithmeTick"
  description="Playful Grade 1 to 3 maths for Kenyan families. Brijo the owl reads every instruction aloud, children count real things, and grown-ups join in."
  current="home"
  schema={schema}
>
  <section class="hero">
    <div class="pattern hero-pattern" aria-hidden="true"></div>
    <div class="container hero-grid">
      <div class="hero-copy">
        <h1 class="display">Turn screen time into maths confidence.</h1>
        <p class="lede">
          Short maths games for Grades 1 to 3. Brijo the owl reads every instruction aloud, so children can play before
          they can read.
        </p>
        <div class="actions">
          <PlayButton />
          <a class="btn btn-outline" href={hasTour ? "#tour" : "/how-it-works"}>
            <img src={F + "play-circle.svg"} width="24" height="24" alt="" />
            {hasTour ? "Watch the tour" : "See how it works"}
          </a>
        </div>
        <ul class="facts" aria-label="At a glance">
          <li>CBC Grades 1 to 3</li>
          <li>Ages 6 to 9</li>
          <li>Android</li>
          <li>Free during the beta</li>
          <li>15 minutes a day</li>
        </ul>
        <p class="trust">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3 4.5 6v5.5c0 4.5 3.2 8.4 7.5 9.5 4.3-1.1 7.5-5 7.5-9.5V6z"></path><path d="m9 12 2 2 4-4"></path></svg>
          <span>No ads, and we never sell your family's data. Progress is saved with your account, for your eyes only. <a href="/privacy">Privacy</a></span>
        </p>
      </div>
      <div class="hero-art" aria-label="Screens from the ArithmeTick app">
        <div class="glow" aria-hidden="true"></div>
        <figure class="phone back">
          <img src="/images/app/level.jpg" width="390" height="844" alt="A level: Brijo asks the child to collect 7 feathers" />
        </figure>
        <figure class="phone front">
          <img src="/images/app/map.jpg" width="390" height="844" alt="The jungle map of Grade 1 levels" />
        </figure>
        <img class="pal fox" src={F + "fox.png"} width="64" height="64" alt="" />
        <img class="pal cheetah" src={F + "cheetah.png"} width="64" height="64" alt="" />
      </div>
    </div>

    <div class="container pillars">
      <div class="section-head">
        <h2 class="heading-lg">Maths doesn't have to be a chore</h2>
        <p class="lede">Every level is real Grade 1 to 3 maths, built to feel like a game a child wants to play again.</p>
      </div>
      <div class="cards">
        <FeatureCard icon={F + "phone.svg"} title="Screen time you can feel good about">
          Each level practises a skill from Kenya's CBC maths curriculum for Grades 1 to 3, and a daily 15-minute limit keeps play short.
        </FeatureCard>
        <FeatureCard icon={F + "puzzle.svg"} title="Low-anxiety, playful learning">
          Brijo guides children through mistakes with gentle hints. A wrong answer never costs stars.
        </FeatureCard>
        <FeatureCard icon={F + "chart.svg"} title="See how they're doing">
          Turn on a weekly email: levels, stars, what they're strong at, and one game to try at home.
        </FeatureCard>
      </div>
    </div>
  </section>

  <ProductVideo
    title="One level, start to finish"
    text="A minute of real play: Brijo sets the task, the child counts, and the stars come in."
    points={[
      "Brijo reads the instruction aloud and the words light up.",
      "The child taps, drags and counts real things.",
      "A wrong answer gets a gentle hint, never a lost star.",
    ]}
  />

  <section class="split">
    <div class="container split-grid">
      <div class="row">
        <div class="mock kids-mock">
          <div class="tilt teal" aria-hidden="true"></div>
          <figure class="phone md">
            <img src="/images/app/badges.jpg" width="390" height="844" loading="lazy" alt="Jabali's badges: 1 of 18 won, with Feather Finder next up" />
          </figure>
        </div>
        <div class="copy">
          <p class="kicker teal-text heading-lg">For kids</p>
          <h2 class="heading-sm">A learning adventure they actually ask to play</h2>
          <ul class="ticks">
            <li><img src={F + "route.svg"} width="24" height="24" alt="" />A jungle map of short levels, one small step at a time.</li>
            <li><img src={F + "award.svg"} width="24" height="24" alt="" />Stars, badges and a family star goal to win together.</li>
            <li><img src={F + "calculator.svg"} width="24" height="24" alt="" />Count, group and share real things: bottle tops, mangoes, seeds and chapati.</li>
          </ul>
        </div>
      </div>

      <div class="row reverse">
        <div class="copy">
          <p class="kicker purple-text heading-lg">For parents</p>
          <h2 class="heading-sm">Stay connected without hovering</h2>
          <ul class="ticks">
            <li><img src={F + "user-plus.svg"} width="24" height="24" alt="" />Separate profiles for up to 4 children, each with their own progress.</li>
            <li><img src={F + "chart-purple.svg"} width="24" height="24" alt="" />An optional weekly email report, and another when a grade is finished.</li>
            <li><img src={F + "graduation.svg"} width="24" height="24" alt="" />Grown-up settings sit behind a 2-second hold, so children can't change them.</li>
          </ul>
        </div>
        <div class="mock parents-mock">
          <div class="tilt purple" aria-hidden="true"></div>
          <div class="shots">
            <figure class="email">
              <img src="/images/app/report.jpg" width="408" height="843" loading="lazy" alt="An example weekly report email: Jabali did 4 levels and earned 9 stars, Making 10 is strong, with an idea to try at home" />
            </figure>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="move">
    <div class="pattern move-pattern" aria-hidden="true"></div>
    <div class="container">
      <div class="section-head">
        <h2 class="heading-lg">Maths away from the screen</h2>
        <p class="lede">Every few levels, a Move & Play activity takes the maths into the home, with a grown-up.</p>
      </div>
      <div class="move-cards">
        {
          moveAndPlay.map((m, i) => (
            <article class={`move-card c${i}`}>
              <span class="tag">{m.grade}</span>
              <h3 class="heading-sm">{m.title}</h3>
              <p>{m.text}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <Faq items={FAQ} />

  <CtaBand
    title="Give your child the gift of maths confidence."
    text="ArithmeTick is free during the beta. Install it from Google Play and try it with your family tonight."
  />
</Base>

<style>
  .hero {
    position: relative;
    overflow: hidden;
    background: linear-gradient(180deg, var(--mint-100) 0%, var(--mint-50) 45%, var(--white) 100%);
    padding: var(--section-y) 0;
  }
  .hero-pattern {
    position: absolute;
    inset: 0;
    opacity: 0.5;
  }
  .hero-grid {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: 40px;
    align-items: center;
  }
  .hero-copy {
    display: flex;
    flex-direction: column;
    gap: 24px;
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 16px;
  }
  .actions :global(.btn) {
    flex: 0 1 auto;
    white-space: nowrap;
  }
  @media (max-width: 480px) {
    .actions :global(.btn) {
      flex: 1 1 100%;
    }
  }
  .trust {
    display: flex;
    align-items: flex-start;
    gap: var(--space-2);
    color: var(--ink);
    font-size: 15px;
    font-weight: 600;
  }
  .trust svg {
    flex: none;
    margin-top: 1px;
    color: var(--teal-700);
  }
  .facts {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .facts li {
    padding: 4px 12px;
    border-radius: var(--radius-pill);
    background: var(--white);
    border: 1px solid var(--line);
    color: var(--ink);
    font-size: 15px;
    font-weight: 600;
  }
  .hero-art {
    position: relative;
    height: 500px;
  }
  .glow {
    position: absolute;
    inset: 40px 20px;
    border-radius: 9999px;
    background: var(--mint-100);
    opacity: 0.3;
    filter: blur(50px);
  }
  .phone {
    position: absolute;
    margin: 0;
    width: 220px;
    border-radius: 32px;
    overflow: hidden;
    border: 6px solid var(--text);
    background: var(--text);
    box-shadow: 0 8px 24px rgba(0, 107, 98, 0.18);
  }
  .phone img {
    display: block;
    width: 100%;
    height: auto;
    border-radius: 26px;
  }
  .phone.front {
    left: 8%;
    top: 30px;
    rotate: -5deg;
    z-index: 2;
  }
  .phone.back {
    right: 6%;
    top: 0;
    rotate: 5deg;
  }
  .pal {
    position: absolute;
    z-index: 3;
    width: 64px;
    height: 64px;
    border-radius: 9999px;
    padding: 6px;
    background: var(--white);
    box-shadow: var(--shadow-card);
  }
  .pal.fox {
    right: 0;
    bottom: 40px;
  }
  .pal.cheetah {
    left: 0;
    top: 8px;
  }

  .pillars {
    position: relative;
    margin-top: 80px;
    display: flex;
    flex-direction: column;
    gap: 40px;
  }
  .section-head {
    display: flex;
    flex-direction: column;
    gap: 12px;
    max-width: 700px;
    margin: 0 auto;
    text-align: center;
  }
  .cards {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 24px;
  }

  .split {
    padding: var(--section-y) 0;
    overflow-x: clip;
  }
  .split-grid {
    display: flex;
    flex-direction: column;
    gap: 80px;
  }
  .row {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: 40px;
    align-items: center;
  }
  .copy {
    display: flex;
    flex-direction: column;
    gap: 24px;
  }
  .kicker {
    margin-bottom: -8px;
  }
  .teal-text {
    color: var(--teal-700);
  }
  .purple-text {
    color: var(--purple-600);
  }
  .ticks {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 14px;
  }
  .ticks li {
    display: flex;
    gap: 12px;
    align-items: flex-start;
    font-size: clamp(17px, 1.9vw, 20px);
  }
  .ticks img {
    flex: none;
    margin-top: 2px;
  }
  .mock {
    position: relative;
    display: grid;
    place-items: center;
    padding: var(--space-8) var(--space-6);
  }
  .tilt.teal {
    background: var(--mint-100);
    rotate: -4deg;
  }
  .tilt.purple {
    background: var(--purple-100);
    rotate: 4deg;
  }
  .phone.md {
    position: relative;
    rotate: none;
  }
  .phone.md {
    width: min(260px, 70vw);
  }
  .shots {
    position: relative;
    display: flex;
    align-items: flex-end;
    justify-content: center;
  }
  .email {
    width: min(300px, 76vw);
    margin: 0;
    border-radius: var(--radius-xl);
    overflow: hidden;
    box-shadow: var(--shadow-pop);
  }
  .email img {
    display: block;
    width: 100%;
    height: auto;
  }
  .tilt {
    position: absolute;
    inset: 0;
    border-radius: var(--radius-xl);
  }

  .move {
    position: relative;
    overflow: hidden;
    background: var(--purple-100);
    padding: var(--section-y) 0;
  }
  .move-pattern {
    position: absolute;
    inset: 0;
    opacity: 0.45;
  }
  .move .container {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 40px;
  }
  .move-cards {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 24px;
  }
  .move-card {
    display: flex;
    flex-direction: column;
    gap: 12px;
    padding: 28px;
    border-radius: var(--radius-lg);
    border: 2px solid transparent;
    box-shadow: var(--shadow-card);
    font-size: 17px;
  }
  .move-card.c0 {
    background: var(--mint-50);
    border-color: var(--line);
  }
  .move-card.c1 {
    background: var(--sun-50);
    border-color: var(--sun-100);
  }
  .move-card.c2 {
    background: var(--purple-50);
    border-color: var(--purple-200);
  }
  .tag {
    align-self: flex-start;
    padding: 2px 12px;
    border-radius: 9999px;
    background: var(--white);
    font-size: 14px;
    font-weight: 700;
    color: var(--ink);
  }

  @media (max-width: 900px) {
    .hero-grid,
    .row {
      grid-template-columns: 1fr;
    }
    .row.reverse .copy {
      order: -1;
    }
    .hero-art {
      height: 440px;
      max-width: 460px;
      width: 100%;
      margin: 0 auto;
    }
    .cards,
    .move-cards {
      grid-template-columns: 1fr;
    }
  }
  @media (max-width: 600px) {
    .mock {
      padding: var(--space-6) var(--space-4);
    }
  }
  @media (max-width: 480px) {
    .phone {
      width: 180px;
    }
    .hero-art {
      height: 380px;
    }
  }
</style>
