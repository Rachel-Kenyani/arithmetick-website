---
import "../styles/global.css";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import Analytics from "../components/Analytics.astro";
import StickyPlay from "../components/StickyPlay.astro";
import Cursor from "../components/Cursor.astro";
import { PLAY_STORE_URL, SUPPORT_EMAIL } from "../data/site";

interface Props {
  title: string;
  description: string;
  /** The nav link to mark as the current page. */
  current?: "home" | "how" | "story" | "privacy" | "contact";
  /** Extra schema.org JSON-LD objects for this page. */
  schema?: Record<string, unknown>[];
  /** Show the Play badge in a bar at the bottom of small screens once the page's own badges scroll away. */
  stickyPlay?: boolean;
  /** Keep the page out of search results (404). */
  noindex?: boolean;
}

const { title, description, current, schema = [], noindex = false, stickyPlay = !noindex } = Astro.props;
const fullTitle = title === "ArithmeTick" ? title : `${title} · ArithmeTick`;
const site = Astro.site ?? new URL("https://arithmetick.rachelkenyani.com");
const canonical = new URL(Astro.url.pathname.replace(/\.html$/, "").replace(/\/index$/, "") || "/", site);
const ogImage = new URL("/images/og.jpg", site);
const siteSchema = [
  {
    "@context": "https://schema.org",
    "@type": "Organization",
    "@id": `${site.origin}/#org`,
    name: "ArithmeTick",
    url: site.origin,
    logo: new URL("/favicon.png", site).href,
    email: SUPPORT_EMAIL,
    founder: { "@type": "Person", name: "Rachel Kenyani" },
    address: { "@type": "PostalAddress", addressLocality: "Nairobi", addressCountry: "KE" },
    sameAs: [PLAY_STORE_URL],
  },
  {
    "@context": "https://schema.org",
    "@type": "WebSite",
    name: "ArithmeTick",
    url: site.origin,
    inLanguage: "en-KE",
    publisher: { "@id": `${site.origin}/#org` },
  },
  ...(canonical.pathname === "/" || noindex
    ? []
    : [
        {
          "@context": "https://schema.org",
          "@type": "BreadcrumbList",
          itemListElement: [
            { "@type": "ListItem", position: 1, name: "Home", item: site.origin },
            { "@type": "ListItem", position: 2, name: title, item: canonical.href },
          ],
        },
      ]),
];
---

<!doctype html>
<html lang="en-KE">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#006f68" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="ArithmeTick" />
    <meta property="og:locale" content="en_KE" />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="ArithmeTick: maths games for Grades 1 to 3, with Brijo the owl" />
    <meta name="twitter:card" content="summary_large_image" />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="sitemap" href="/sitemap.xml" />
    <link rel="alternate" type="text/markdown" title="ArithmeTick for AI agents" href="/llms.txt" />
    {[...siteSchema, ...schema].map((s) => <script type="application/ld+json" set:html={JSON.stringify(s)} />)}
    <link rel="preload" href="/fonts/figtree-latin.woff2" as="font" type="font/woff2" crossorigin />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <Nav current={current} overHero={current === "home"} />
    <main id="main">
      <slot />
    </main>
    <Footer />
    {stickyPlay && <StickyPlay />}
    <script>
      /* Reveal on scroll for browsers without CSS scroll-driven animations; the CSS version needs no script. */
      const targets = "main > section:not(:first-of-type) :is(.section-head, .copy, .mock, .animals, article, .step, .move-card, .faq-group)";
      const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
      if (!reduce && !CSS.supports("animation-timeline: view()") && "IntersectionObserver" in window) {
        const observer = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (entry.isIntersecting) {
                entry.target.classList.add("revealed");
                observer.unobserve(entry.target);
              }
            }
          },
          { rootMargin: "0px 0px -10% 0px" },
        );
        document.documentElement.classList.add("reveal-fallback");
        for (const el of document.querySelectorAll(targets)) {
          observer.observe(el);
        }
      }
    </script>
    <Cursor />
    <Analytics />
    <script src="../scripts/webmcp.ts"></script>
  </body>
</html>

<style>
  .skip {
    position: absolute;
    left: 16px;
    top: -60px;
    z-index: 50;
    padding: 10px 16px;
    border-radius: 8px;
    background: var(--teal-700);
    color: var(--white);
    font-weight: 700;
    text-decoration: none;
  }
  .skip:focus {
    top: 12px;
  }
</style>
